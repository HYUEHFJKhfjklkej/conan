# grpc-tc-mirror build container - x86_64. FROM the gcc84 CI base + Conan.
# Single stage (base already ships gcc 8.4). Sources are NOT baked - drivers
# mount the repo at /work/conan-recipes at run time.
# X64_BASE_IMAGE is unused in this single-stage file (no x64_native_tc stage —
# the base already ships gcc 8.4). It is declared only to consume the build-arg
# that prebake_push.sh passes uniformly to all three arches, so Docker doesn't
# warn "build-arg X64_BASE_IMAGE not consumed". The arm/arm64 files do use it.
ARG X64_BASE_IMAGE=proget.inc.elara.local/main/library/gcc84-build-x86_64:0.1.0
ARG BASE_IMAGE=proget.inc.elara.local/main/library/gcc84-build-x86_64:0.1.0
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /work/conan-recipes

# Profile lin-gcc84-x86_64 wants gcc at /opt/x64-native-gcc/bin/{gcc,g++}; the
# base has it at /usr/local/gcc-8.4 (version-named bins). Expose path + aliases.
RUN set -e; \
    ln -s /usr/local/gcc-8.4 /opt/x64-native-gcc; \
    cd /opt/x64-native-gcc/bin; \
    for a in "gcc gcc-8.4" "g++ g++-8.4" "cc gcc-8.4" "c++ g++-8.4" "cpp cpp-8.4" \
             "gcc-ar gcc-ar-8.4" "gcc-nm gcc-nm-8.4" "gcc-ranlib gcc-ranlib-8.4"; do \
        set -- $a; [ -e "$1" ] || ln -sf "$2" "$1"; \
    done

# Python 3.11 + Conan, offline from packages-linux/ (Stretch ships 3.5; Conan 2
# needs >=3.7). No venv - ensurepip is broken in the standalone tarball.
COPY packages-linux /work/conan-recipes/packages-linux
RUN tar -xzf packages-linux/cpython-3.11.10+20240909-x86_64-linux-gnu.tar.gz -C /opt \
    && ln -sf /opt/python/bin/python3 /usr/local/bin/python3 \
    && ln -sf /opt/python/bin/python3 /usr/local/bin/python \
    && ln -sf /opt/python/bin/pip3    /usr/local/bin/pip \
    && /opt/python/bin/python3 -m pip install --no-index --find-links=packages-linux \
        pip setuptools wheel conan \
    && ln -sf /opt/python/bin/conan /usr/local/bin/conan \
    && conan --version

# No PROFILE/PROFILE_BUILD is baked here: the build profile is a build-step
# decision passed at run time (TeamCity / test-astra drivers via -e PROFILE /
# -e PROFILE_BUILD). The image is an environment, not a build config — baking a
# profile would be dead state now that nothing auto-builds, and on the ARM
# images it would even pin the wrong (x86_64) host profile.
ENV PROGET_SOURCES_URL="http://proget.inc.elara.local/endpoints/conan-sources/content/"

# Bake the ProGet backup-sources line so a fresh/absent cache volume already has
# it; ensure_proget.sh re-asserts it for reused volumes (HELP [16]).
RUN mkdir -p /root/.conan2 \
    && printf 'core.sources:download_urls=["%s", "origin"]\n' "$PROGET_SOURCES_URL" \
        >> /root/.conan2/global.conf

# Build environment only — the image is meant to BE part of a CI agent, not to
# run a build on its own. grpc is built by an external step (TeamCity, or the
# test-astra drivers) that mounts the repo and passes its own command. A bare
# `docker run` just drops into a shell; it never auto-builds grpc.
CMD ["bash"]
