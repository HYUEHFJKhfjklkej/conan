# Окружение сборки grpc-tc-mirror (arm64): база gcc75-build-arm64 + Conan; репо монтируется в рантайме.
ARG X64_BASE_IMAGE=proget.inc.elara.local/main/library/gcc84-build-x86_64:0.1.0
ARG BASE_IMAGE=proget.inc.elara.local/main/library/gcc75-build-arm64:0.1.0

# Тащим gcc 8.4 из x86_64-базы для build-контекста: abseil требует gcc >=7, а системный gcc
# ARM-базы — 6.3 (на нём не собирается). cp -aL разыменовывает симлинки, чтобы COPY --from ниже не повис.
FROM ${X64_BASE_IMAGE} AS x64_native_tc
RUN set -e; \
    [ -d /usr/local/gcc-8.4 ] || { echo "FATAL: gcc-8.4 missing in $X64_BASE_IMAGE"; exit 1; }; \
    mkdir -p /opt/x64-native-gcc; cp -aL /usr/local/gcc-8.4/. /opt/x64-native-gcc/; \
    cd /opt/x64-native-gcc/bin; \
    for a in "gcc gcc-8.4" "g++ g++-8.4" "cc gcc-8.4" "c++ g++-8.4" "cpp cpp-8.4" \
             "gcc-ar gcc-ar-8.4" "gcc-nm gcc-nm-8.4" "gcc-ranlib gcc-ranlib-8.4"; do \
        set -- $a; [ -e "$1" ] || ln -sf "$2" "$1"; \
    done

FROM ${BASE_IMAGE}
COPY --from=x64_native_tc /opt/x64-native-gcc /opt/x64-native-gcc

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /work/conan-recipes

# Python 3.11 + Conan офлайн из packages-linux/ (Stretch несёт 3.5, Conan 2 хочет >=3.7).
COPY packages-linux /work/conan-recipes/packages-linux
RUN tar -xzf packages-linux/cpython-3.11.10+20240909-x86_64-linux-gnu.tar.gz -C /opt \
    && ln -sf /opt/python/bin/python3 /usr/local/bin/python3 \
    && ln -sf /opt/python/bin/python3 /usr/local/bin/python \
    && ln -sf /opt/python/bin/pip3    /usr/local/bin/pip \
    && /opt/python/bin/python3 -m pip install --no-index --find-links=packages-linux \
        pip setuptools wheel conan meson ninja \
    && ln -sf /opt/python/bin/conan /usr/local/bin/conan \
    && ln -sf /opt/python/bin/meson /usr/local/bin/meson \
    && ln -sf /opt/python/bin/ninja /usr/local/bin/ninja \
    && conan --version

ENV PROGET_SOURCES_URL="http://proget.inc.elara.local/endpoints/conan-sources/content/"
