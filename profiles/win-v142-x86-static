[settings]
os=Windows
arch=x86
compiler=msvc
compiler.version=192
compiler.cppstd=17
compiler.runtime=static
build_type=Release

[conf]
# см. win-v142-x64: VS2022-генератор + тулсет v142 (иначе ищет установленную VS2019)
tools.cmake.cmaketoolchain:generator=Visual Studio 17 2022
# vcvars-путь (openssl и прочие не-CMake рецепты): msvc 192 по умолчанию ищет
# установку VS16 ("VS non-existing installation: Visual Studio 16"). Берём
# vcvars из VS17/2022, версию тулчейна (-vcvars_ver=14.2) conan ставит сам.
tools.microsoft.msbuild:vs_version=17

[platform_tool_requires]
cmake/3.25.1
perl/5.32.1
nasm/2.16.01
strawberryperl/5.32.1.1

{% set tools_dir = profile_dir + "/../tools/windows" %}

[buildenv]
# vcvarsall x86 (кросс-тулзы x64->x86) меняет CWD при активации окружения ->
# nmake падал "U1064: MAKEFILE not found" (openssl: makefile создан, но nmake
# запущен не там). VSCMD_START_DIR возвращает vcvars в исходную директорию;
# %CD% разворачивается в момент вызова conanbuild.bat, т.е. в правильный cwd.
VSCMD_START_DIR=%CD%
PATH=+(path){{ tools_dir }}/strawberryperl/perl/bin
PATH=+(path){{ tools_dir }}/nasm
PATH+=(path)C:\Strawberry\perl\bin
PATH+=(path)C:\Program Files\NASM
