[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=8.4
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=Release

[platform_tool_requires]
# Use system-provided tools instead of building them via Conan.
# Required because we operate in --no-remote mode (no Conan-built cmake/perl available).
cmake/3.25.1
libtool/2.4.7
autoconf/2.71
automake/1.16.5
meson/1.4.0
perl/5.36.0

# When this profile is used as PROFILE_BUILD for an ARM cross (host)
# profile that exports arm-linux-gnueabihf-* via [buildenv], those
# values otherwise leak into the build context — protoc would link
# with arm-ld and fail. Pin native toolchain explicitly.
#
# We point at /usr/local/gcc-8.4/bin/gcc instead of plain `gcc` because
# the arm/arm64 base images (gcc75-build-arm:0.1.0,
# gcc75-build-arm64:0.1.0) ship Debian Stretch system gcc 6.3 as the
# default `gcc` on PATH, and abseil 20250127 hard-rejects gcc < 7 via
# policy_checks.h. Dockerfile.grpc-tc-mirror copies gcc-8.4 from the
# x86_64 CI image into /usr/local/gcc-8.4, so this absolute path
# resolves the same way in arm and x86_64 mirrors.
[buildenv]
CC=/opt/x64-native-gcc/bin/gcc
CXX=/opt/x64-native-gcc/bin/g++
AR=ar
AS=as
LD=ld
NM=nm
RANLIB=ranlib
STRIP=strip

[conf]
# системный pkg-config (libxml2 и др. autotools-рецепты)
tools.gnu:pkg_config=pkg-config
tools.build:compiler_executables={"c": "/opt/x64-native-gcc/bin/gcc", "cpp": "/opt/x64-native-gcc/bin/g++"}
