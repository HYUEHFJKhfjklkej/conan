[settings]
os=Linux
arch=armv7hf
compiler=gcc
compiler.version=7.5
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=Release

[platform_tool_requires]
cmake/3.25.1
libtool/2.4.7
autoconf/2.71
automake/1.16.5
meson/1.4.0
perl/5.36.0

[buildenv]
PATH=+(path)/opt/linaro-arm-7.5.0/gcc-linaro-7.5.0-2019.12-rc1-x86_64_arm-linux-gnueabihf/bin
CC=arm-linux-gnueabihf-gcc
CXX=arm-linux-gnueabihf-g++
AR=arm-linux-gnueabihf-ar
AS=arm-linux-gnueabihf-as
LD=arm-linux-gnueabihf-ld
NM=arm-linux-gnueabihf-nm
RANLIB=arm-linux-gnueabihf-ranlib
STRIP=arm-linux-gnueabihf-strip

[conf]
# системный pkg-config (libxml2 и др. autotools-рецепты)
tools.gnu:pkg_config=pkg-config
*:tools.cmake.cmaketoolchain:user_toolchain=["{{ profile_dir }}/toolchains/linaro-arm.cmake"]
